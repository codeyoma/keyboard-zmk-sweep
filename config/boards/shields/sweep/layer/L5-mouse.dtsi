/**
 *
 */

/ {
  keymap {
    compatible = "zmk,keymap";

	mouse_layer {
		label = "Mouse";
		bindings = <
//	╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮   ╭───────────────┬───────────────┬───────────────┬───────────────┬───────────────╮
	XXXXXXXX        XXXXXXXX        &mmv MOVE_UP    XXXXXXXX        XXXXXXXX            XXXXXXXX        XXXXXXXX        XXXXXXXX        XXXXXXXX        XXXXXXXX
//	├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────├───────────────┼───────────────┼───────────────┼───────────────┤
	XXXXXXXX        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT &tog MOUSE          &mkp MB4        &mkp LCLK       &mkp RCLK       &mkp MCLK       &mkp MB5
//	├───────────────┼───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────├───────────────┼───────────────┼───────────────┼───────────────┤
	&kp LCTRL       &kp LGUI        &kp LALT        &kp LSHFT       XXXXXXXX            &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT XXXXXXXX
//	╰───────────────┴───────────────┼───────────────┼───────────────┼───────────────┤   ├───────────────├───────────────┼───────────────┼───────────────┴───────────────╯
	       											________        ________           	________		________
//                                                  ╰───────────────┴───────────────╯   ╰───────────────┴───────────────╯
			>;
		};
	};
};
